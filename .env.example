# Higherway — copy to .env.local and fill in.
# Never commit a filled-in copy. See ARCHITECTURE.md §12.

# ── Site ────────────────────────────────────────────────────────────────────
# Stays on the Vercel URL until the project's own domain is bought, so Google
# never indexes a temporary address. Used by sitemap, canonical URLs and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (Neon) ─────────────────────────────────────────────────────────
# neon.com → project → Connection string. Free plan: 0.5 GB.
DATABASE_URL="postgresql://user:password@host.neon.tech/higherway?sslmode=require"

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# ── Files (Cloudflare R2) ───────────────────────────────────────────────────
# Cloudflare dashboard → R2 → Manage API tokens. Bucket: higherway
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET="higherway"
# Custom domain on the bucket. The free r2.dev address is rate-limited and
# Cloudflare says it is not for production.
R2_PUBLIC_BASE_URL="https://cdn-higherway.mavilletech.com"

# ── Suggestions (Cloudflare Workers AI) ─────────────────────────────────────
# Free: 10,000 neurons/day — enough for the whole backlog in about a day.
# Cloudflare does not train on content sent here.
# Unset → falls back to embedding-similarity suggestions, which need no account.
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_TOKEN="your-workers-ai-token"

# ── OCR (Google Cloud Vision) ───────────────────────────────────────────────
# Free: 1,000 pages/month. We need ~35. Google requires a billing account on
# file even at zero spend. Unset → falls back to tesseract.js automatically.
GOOGLE_CLOUD_VISION_KEY=""

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Sends from a verified mavilletech.com address. Free: 3,000/month, 100/day.
RESEND_API_KEY="re_your_key"
EMAIL_FROM="Higherway <no-reply@mavilletech.com>"

# ── Background jobs (Trigger.dev) ───────────────────────────────────────────
TRIGGER_SECRET_KEY="tr_dev_your_key"

# ── Google Drive (read-only, Phase 6) ───────────────────────────────────────
# A service account with READ access to the folder. The app never writes to Drive.
GOOGLE_SERVICE_ACCOUNT_EMAIL="higherway-sync@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="1Cx9XJ-8lsnvjBxpK59HnYfp_dZZUpb9D"

# ── First Owner account (pnpm db:seed) ──────────────────────────────────────
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Higherway Owner"

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Public submissions (after launch) ───────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
