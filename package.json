{
  "name": "hw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "env:check": "tsx --env-file=.env.local scripts/check-env.ts",
    "service:account": "tsx scripts/service-account.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "import:sheet": "tsx --env-file=.env.local scripts/import-sheet.ts",
    "backfill": "tsx --env-file=.env.local scripts/backfill.ts",
    "embed": "tsx --env-file=.env.local scripts/embed.ts",
    "ocr:local": "tsx --env-file=.env.local scripts/ocr-local.ts",
    "ocr:status": "tsx --env-file=.env.local scripts/ocr-status.ts",
    "fix:names": "tsx --env-file=.env.local scripts/fix-download-names.ts",
    "reinvite": "tsx --env-file=.env.local scripts/reinvite-owner.ts",
    "account:delete": "tsx --env-file=.env.local scripts/delete-account.ts",
    "topics:describe": "tsx --env-file=.env.local scripts/describe-topics.ts",
    "scan:duplicates": "tsx --env-file=.env.local scripts/scan-duplicates.ts",
    "resolve:stuck": "tsx --env-file=.env.local scripts/resolve-stuck.ts",
    "fix:hyphens": "tsx --env-file=.env.local scripts/fix-hyphens.ts",
    "r2:cors": "tsx --env-file=.env.local scripts/r2-cors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@trigger.dev/sdk": "4.6.2",
    "@types/ws": "^8.18.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "mupdf": "^1.28.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@trigger.dev/build": "4.6.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "trigger.dev": "4.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
